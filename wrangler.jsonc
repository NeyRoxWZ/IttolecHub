{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "custom-worker.ts",
  "name": "itollechub",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "itollechub"
    }
  ],
  "observability": {
    "enabled": true
  },
  // The two daily push sweeps that were Vercel crons (UTC).
  "triggers": {
    "crons": ["0 7 * * *", "0 19 * * *"]
  },
  // Only itollechub.com: no second public address on workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  // The site's own domain, served straight by this Worker.
  "routes": [
    { "pattern": "itollechub.com", "custom_domain": true }
  ]
}
